{
  "name": "veridia",
  "version": "0.1.6",
  "description": "Model-agnostic quality through mechanics, not through the model.",
  "type": "module",
  "bin": {
    "veridia": "dist/cli/index.js"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "lint": "eslint .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "prepublishOnly": "pnpm build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dadosh1984/veridia.git"
  },
  "homepage": "https://github.com/dadosh1984/veridia#readme",
  "bugs": {
    "url": "https://github.com/dadosh1984/veridia/issues"
  },
  "keywords": [
    "quality",
    "triage",
    "verification",
    "cli",
    "typescript"
  ],
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "skills/"
  ],
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "cac": "^7.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.10"
  }
}
