{
  "name": "veridia",
  "version": "0.2.0",
  "description": "Model-agnostic quality through mechanics, not through the model.",
  "type": "module",
  "bin": {
    "veridia": "dist/cli/index.js",
    "veridia-mcp": "dist/mcp/index.js"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "bun run build.ts",
    "dev": "bun run build.ts --watch",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "lint": "biome check src/ test/",
    "lint:fix": "biome check --write --unsafe src/ test/",
    "format": "biome format --write src/ test/",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "bunx tsc --noEmit",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "bun run build && changeset publish",
    "prepublishOnly": "bun run build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dadosh1984/veridia.git"
  },
  "homepage": "https://github.com/dadosh1984/veridia#readme",
  "bugs": {
    "url": "https://github.com/dadosh1984/veridia/issues"
  },
  "keywords": [
    "quality",
    "triage",
    "verification",
    "cli",
    "typescript"
  ],
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "skills/"
  ],
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "cac": "^7.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@changesets/cli": "^2.31.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.10"
  }
}
