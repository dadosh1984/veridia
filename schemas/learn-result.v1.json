{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LearnResult",
  "protocol": "veridia/learn-result/v1",
  "type": "object",
  "required": ["protocol", "totalRuns", "classificationAccuracy", "successRateByLevel", "driftPatterns", "recommendations", "oraclePrecision"],
  "properties": {
    "protocol": { "type": "string", "const": "veridia/learn-result/v1" },
    "totalRuns": { "type": "integer", "minimum": 0 },
    "classificationAccuracy": { "type": "object", "additionalProperties": { "type": "number" } },
    "successRateByLevel": { "type": "object", "additionalProperties": { "type": "number" } },
    "driftPatterns": { "type": "array", "items": { "type": "string" } },
    "recommendations": { "type": "array", "items": { "type": "string" } },
    "oraclePrecision": { "type": "object", "additionalProperties": { "type": "number" } }
  }
}
