{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VerificationReport",
  "protocol": "veridia/verification-report/v1",
  "type": "object",
  "required": ["protocol", "checks", "verdict"],
  "properties": {
    "protocol": { "type": "string", "const": "veridia/verification-report/v1" },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "command", "weight", "weak", "passed"],
        "properties": {
          "kind": { "type": "string", "enum": ["test-runner", "type-check", "lint", "ci", "test-content", "human-review"] },
          "command": { "type": "string" },
          "weight": { "type": "number", "minimum": 0 },
          "weak": { "type": "boolean" },
          "passed": { "type": "boolean" },
          "error": { "type": "string" }
        }
      }
    },
    "verdict": { "type": "string", "enum": ["PASS", "FAIL", "HUMAN"] }
  }
}
